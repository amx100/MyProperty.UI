@inherits LoginViewModel

<EditForm Model="@Login" OnValidSubmit="ExecuteLogin" class="login-form">
    <DataAnnotationsValidator/>
    <MudCard Class="login-card" Elevation="0">
        <MudCardHeader Class="login-header">
            <CardHeaderContent>
                <MudText Typo="Typo.h4" Class="login-title">Welcome Back</MudText>
                <MudText Typo="Typo.body1" Class="login-subtitle">Please sign in to continue</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudTextField Variant="Variant.Outlined" 
                         Label="Email" 
                         @bind-Value="Login.Email" 
                         For="@(() => Login.Email)"
                         Class="login-input"
                         InputType="InputType.Email"/>
            <MudTextField Variant="Variant.Outlined" 
                         Label="Password" 
                         Class="login-input"
                         @bind-Value="Login.Password" 
                         For="@(() => Login.Password)" 
                         InputType="@PasswordInput" 
                         Adornment="Adornment.End" 
                         AdornmentIcon="@PasswordInputIcon" 
                         OnAdornmentClick="ShowHidePassword" 
                         AdornmentAriaLabel="Show Password"/>
            @if (ShowAuthError)
            {
                <MudAlert Class="mt-3" Severity="Severity.Error" Variant="Variant.Filled">@Error</MudAlert>
            }
            <MudText Style="cursor:pointer" 
                     Class="mt-3 forgot-password" 
                     @onclick="OpenForgotPasswordPage" 
                     Typo="Typo.body2">
                Forgot password?
            </MudText>
        </MudCardContent>
        <MudCardActions Class="login-actions">
            <MudButton ButtonType="ButtonType.Submit" 
                      Class="login-button" 
                      Variant="Variant.Filled" 
                      FullWidth="true">
                Sign In
            </MudButton>
            <MudButton Class="register-button" 
                      Variant="Variant.Outlined" 
                      @onclick="Registration">
                Create Account
            </MudButton>
        </MudCardActions>
    </MudCard>
</EditForm>

<style>
    :root {
        --primary-blue: #2E5CAA;
        --secondary-teal: #298FA1;
        --dark-blue: #1E2C49;
        --accent-gray: #8290A3;
        --black: #000000;
    }

    .login-form {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 2rem;
        background: linear-gradient(135deg, var(--dark-blue) 0%, var(--primary-blue) 100%);
    }

    .login-card {
        width: 100%;
        max-width: 450px;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.95);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    }

    .login-header {
        text-align: center;
        padding: 2rem 1rem;
        border-bottom: 1px solid rgba(130, 144, 163, 0.2);
    }

    .login-title {
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: var(--primary-blue) !important;
    }

    .login-subtitle {
        color: var(--accent-gray) !important;
    }

    .login-input {
        margin-bottom: 1.5rem;
    }

    .login-input ::deep .mud-input {
        border-radius: 8px;
    }

    .login-input ::deep .mud-input-outlined {
        border-color: var(--accent-gray);
    }

    .forgot-password {
        text-align: right;
        color: var(--secondary-teal) !important;
        font-size: 0.875rem;
        transition: color 0.3s ease;
    }

    .forgot-password:hover {
        color: var(--primary-blue) !important;
    }

    .login-actions {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .login-button {
        height: 48px;
        font-size: 1rem;
        font-weight: 500;
        text-transform: none;
        border-radius: 8px;
        background-color: var(--primary-blue) !important;
        color: white !important;
        transition: all 0.3s ease;
    }

    .login-button:hover {
        background-color: var(--dark-blue) !important;
        box-shadow: 0 4px 12px rgba(46, 92, 170, 0.3);
    }

    .register-button {
        height: 48px;
        font-size: 1rem;
        font-weight: 500;
        text-transform: none;
        border-radius: 8px;
        border: 1px solid var(--secondary-teal) !important;
        color: var(--secondary-teal) !important;
        background-color: transparent !important;
        transition: all 0.3s ease;
    }

    .register-button:hover {
        background-color: rgba(41, 143, 161, 0.05) !important;
        border-color: var(--primary-blue) !important;
        color: var(--primary-blue) !important;
    }

    ::deep .mud-input-outlined-border {
        border-color: var(--accent-gray) !important;
    }

    ::deep .mud-input:focus-within .mud-input-outlined-border {
        border-color: var(--primary-blue) !important;
    }

    @@media (max-width: 600px) {
        .login-form {
            padding: 1rem;
        }

        .login-card {
            border-radius: 12px;
        }

        .login-header {
            padding: 1.5rem 1rem;
        }
    }
</style>