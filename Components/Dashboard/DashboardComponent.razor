@using Components.Reservations
@using Contract
@using System.Collections.ObjectModel
@using Microsoft.Extensions.Logging
@using Services.ReservationService
@using System.Security.Claims
@inject IPropertyService PropertyService
@inject IReservationService ReservationService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<DashboardComponent> Logger
@inject TokenStorage tokenStorage

<div class="dashboard-container">
 <div class="filters-container">
    <div class="filters-header">
        <div class="filters-title">
            <i class="bi bi-funnel filter-icon"></i>
            <h2 class="filter-title">Pronađi savršenu nekretninu</h2>
        </div>
        <button class="clear-filters-btn" @onclick="ClearFilters">
            <i class="bi bi-arrow-counterclockwise"></i>
            Očisti filtere
        </button>
    </div>
    
    <div class="filters-body">
        <div class="search-container">
            <div class="search-field">
                <i class="bi bi-search search-icon"></i>
                <input type="text" 
                       placeholder="Pretraži po naslovu ili adresi..." 
                       @bind="SearchPropertyName" 
                       @bind:event="oninput"
                       class="search-input" />
                @if (!string.IsNullOrEmpty(SearchPropertyName))
                {
                    <button class="clear-input" @onclick="@(() => SearchPropertyName = null)">
                        <i class="bi bi-x"></i>
                    </button>
                }
            </div>
        </div>
                     
        <div class="filters-grid">
            <div class="filter-group">
                <label class="filter-label">Tip nekretnine</label>
                <div class="select-container">
                    <i class="bi bi-house-door select-icon"></i>
                    <select class="filter-select" @bind="SelectedPropertyType">
                        <option value="">Svi tipovi</option>
                        @foreach (var type in PropertyTypes)
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>
            </div>
            
            <div class="filter-group">
                <label class="filter-label">Status</label>
                <div class="select-container">
                    <i class="bi bi-bookmark select-icon"></i>
                    <select class="filter-select" @bind="SelectedStatus">
                        <option value="">Svi statusi</option>
                        @foreach (var status in StatusOptions)
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>
            </div>

            <div class="filter-group area-filter">
                <label class="area-label">Površina (m²)</label>
                <div class="area-inputs">
                    <div class="input-container">
                        <input type="number" 
                               class="area-input" 
                               placeholder="Min"
                               @bind="MinArea"
                               @bind:event="oninput" />
                    </div>
                    <div class="area-divider"></div>
                    <div class="input-container">
                        <input type="number" 
                               class="area-input" 
                               placeholder="Max"
                               @bind="MaxArea"
                               @bind:event="oninput" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


    @if (_properties == null)
    {
        <div class="loading-grid">
            @for (var i = 0; i < 3; i++)
            {
                <div class="property-card loading">
                    <div class="card-image-skeleton"></div>
                    <div class="card-content-skeleton">
                        <div class="skeleton-line"></div>
                        <div class="skeleton-line short"></div>
                    </div>
                </div>
            }
        </div>
    }
    else if (!_properties.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">
                <i class="bi bi-building-add"></i>
            </div>
            <h3>Počnimo zajedno</h3>
            <p>Dodajte svoju prvu nekretninu kako biste započeli</p>
        </div>
    }
    else
    {
        <div class="property-grid">
            @foreach (var property in _properties.Where(FilterFunc))
            {
                <div class="property-card" @key="property.PropertyId">
                    <div class="card-media">
                        @if (property.Images?.Any() == true)
                        {
                            <img src="@property.Images.First().ImageUrl" alt="@property.Title" />
                        }
                        else
                        {
                            <div class="media-placeholder">
                                <i class="bi bi-building"></i>
                            </div>
                        }
                        <div class="property-status @GetPropertyStatus(property).ToLower()">
                            @GetPropertyStatus(property)
                        </div>
                    </div>

                    <div class="card-content">
                        <h3 class="property-title">@property.Title</h3>
                        <p class="property-location">
                            <i class="bi bi-geo-alt"></i>
                            @property.Address
                        </p>

                        <div class="property-details">
                            <div class="detail-item">
                                <span class="detail-value">@property.Price.ToString("C")</span>
                                <span class="detail-label">po noćenju</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-value">@property.PropertyType</span>
                                <span class="detail-label">tip</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-value">@property.Area m²</span>
                                <span class="detail-label">površina</span>
                            </div>
                        </div>

                        <div class="card-action">
                            @if (IsPropertyAvailable(property))
                            {
                                <MudButton Color="Color.Primary"
                                           Variant="Variant.Filled"
                                           Class="reservation-button"
                                           OnClick="@(() => CreateReservation(property))">
                                    <i class="bi bi-calendar-check me-2"></i>
                                    Rezerviši
                                </MudButton>
                            }
                            else
                            {
                                <MudButton Color="Color.Error"
                                           Variant="Variant.Outlined"
                                           Class="reserved-button"
                                           Disabled="true">
                                    <i class="bi bi-x-circle me-2"></i>
                                    Rezervisano
                                </MudButton>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

