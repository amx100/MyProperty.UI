@using Components.Reservations
@using Contract
@using System.Collections.ObjectModel
@using Microsoft.Extensions.Logging
@using Services.ReservationService
@using System.Security.Claims
@inject IPropertyService PropertyService
@inject IReservationService ReservationService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<DashboardComponent> Logger
@inject TokenStorage tokenStorage

<div class="dashboard-container">
    @if (_properties == null)
    {
        <div class="skeleton-grid">
            @for (var i = 0; i < 3; i++)
            {
                <div class="property-card shimmer">
                    <div class="media-loader pulse"></div>
                    <div class="content-loader">
                        <div class="line wave"></div>
                        <div class="line short wave"></div>
                    </div>
                </div>
            }
        </div>
    }
    else if (!_properties.Any())
    {
        <div class="empty-state">
            <div class="particle-grid">
                @for (int i = 0; i < 50; i++)
                {
                    <div class="particle" style="--delay: @(i * 0.02)"></div>
                }
            </div>
            <h3 class="neon-title">Let's Start Building</h3>
            <p class="subtitle">Add your first property to begin the journey</p>
        </div>
    }
    else
    {
        <div class="property-grid cinematic-grid">
            @foreach (var property in _properties)
            {
                <div class="property-card" @key="property.PropertyId">
                    <div class="card-inner hover-transform">
                        <div class="media-container parallax-layer">
                            @if (property.Images?.Any() == true)
                            {
                                <img src="@property.Images.First().ImageUrl"
                                     class="zoom-blur"
                                     alt="@property.Title" />
                            }
                            else
                            {
                                <div class="media-placeholder gradient-animate">
                                    <i class="bi bi-building"></i>
                                </div>
                            }
                            <div class="corner-ribbon @property.Status.ToLower()">
                                <span>@property.Status</span>
                            </div>
                        </div>

                        <div class="card-content">
                            <div class="property-header">
                                <h3 class="title-gradient">@property.Title</h3>
                                <p class="location">
                                    <i class="bi bi-geo-alt"></i>
                                    @property.Address
                                </p>
                            </div>

                            <div class="data-grid">
                                <div class="data-item price-bubble">
                                    
                                    <span class="value">@property.Price.ToString("C")</span>
                                    <div class="price-underline"></div>
                                </div>
                                <div class="data-item type-frame">
                                    <span class="value">@property.PropertyType</span>
                                    <div class="type-border"></div>
                                </div>
                                <div class="data-item area-frame">
                                 
                                    <span class="value">@property.Area m²</span>
                                    <div class="area-dots"></div>
                                </div>
                            </div>

                            <div class="action-bar">
                                @if (property.Status?.Equals("Available", StringComparison.OrdinalIgnoreCase) == true)
                                {
                                    <MudButton Color="Color.Primary"
                                               Class="cyber-button"
                                               OnClick="@(() => CreateReservation(property))">
                                        <span class="button-content">
                                            <i class="bi bi-lightning-charge"></i>
                                            Make Reservation
                                        </span>
                                        <div class="button-frame"></div>
                                        <div class="button-overlay"></div>
                                    </MudButton>
                                }
                                else
                                {
                                    <MudButton Color="Color.Warning"
                                               Class="cyber-button-reserved"
                                               Disabled="true">
                                        <span class="button-content">
                                            <i class="bi bi-x-octagon"></i>
                                            Reserved
                                        </span>
                                        <div class="button-frame"></div>
                                        <div class="button-overlay"></div>

                                    </MudButton>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

