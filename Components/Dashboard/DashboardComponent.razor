@using Components.Reservations
@using Contract
@using System.Collections.ObjectModel
@using Microsoft.Extensions.Logging
@using Services.ReservationService
@using System.Security.Claims
@inject IPropertyService PropertyService
@inject IReservationService ReservationService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<DashboardComponent> Logger
@inject TokenStorage tokenStorage

<div class="dashboard-container">
    @if (_properties == null)
    {
        <div class="loading-grid">
            @for (var i = 0; i < 3; i++)
            {
                <div class="property-card loading">
                    <div class="card-image-skeleton"></div>
                    <div class="card-content-skeleton">
                        <div class="skeleton-line"></div>
                        <div class="skeleton-line short"></div>
                    </div>
                </div>
            }
        </div>
    }
    else if (!_properties.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">
                <i class="bi bi-building-add"></i>
            </div>
            <h3>Počnimo zajedno</h3>
            <p>Dodajte svoju prvu nekretninu kako biste započeli</p>
        </div>
    }
    else
    {
        <div class="property-grid">
            @foreach (var property in _properties)
            {
                <div class="property-card" @key="property.PropertyId">
                    <div class="card-media">
                        @if (property.Images?.Any() == true)
                        {
                            <img src="@property.Images.First().ImageUrl" alt="@property.Title" />
                        }
                        else
                        {
                            <div class="media-placeholder">
                                <i class="bi bi-building"></i>
                            </div>
                        }
                        <div class="property-status @GetPropertyStatus(property).ToLower()">
                            @GetPropertyStatus(property)
                        </div>
                    </div>

                    <div class="card-content">
                        <h3 class="property-title">@property.Title</h3>
                        <p class="property-location">
                            <i class="bi bi-geo-alt"></i>
                            @property.Address
                        </p>

                        <div class="property-details">
                            <div class="detail-item">
                                <span class="detail-value">@property.Price.ToString("C")</span>
                                <span class="detail-label">po noćenju</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-value">@property.PropertyType</span>
                                <span class="detail-label">tip</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-value">@property.Area m²</span>
                                <span class="detail-label">površina</span>
                            </div>
                        </div>

                        <div class="card-action">
                            @if (IsPropertyAvailable(property))
                            {
                                <MudButton Color="Color.Primary"
                                           Variant="Variant.Filled"
                                           Class="reservation-button"
                                           OnClick="@(() => CreateReservation(property))">
                                    <i class="bi bi-calendar-check me-2"></i>
                                    Rezerviši
                                </MudButton>
                            }
                            else
                            {
                                <MudButton Color="Color.Error"
                                           Variant="Variant.Outlined"
                                           Class="reserved-button"
                                           Disabled="true">
                                    <i class="bi bi-x-circle me-2"></i>
                                    Rezervisano
                                </MudButton>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    /* Modern clean design */
    :root {
        --primary-color: #4361ee;
        --primary-light: #4895ef;
        --success-color: #10b981;
        --warning-color: #f59e0b;
        --error-color: #ef4444;
        --surface-color: #ffffff;
        --background-color: #f8fafc;
        --text-primary: #1e293b;
        --text-secondary: #64748b;
        --border-color: #e2e8f0;
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;
        --shadow-sm: 0 1px 3px rgba(0,0,0,0.12), 0 1px 2px rgba(0,0,0,0.05);
        --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);
        --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05);
        --transition: all 0.3s ease;
    }

    .dashboard-container {
        max-width: 1600px;
        margin: 0 auto;
        padding: 2rem;
    }

    /* Property grid */
    .property-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 1.5rem;
    }

    /* Property card */
    .property-card {
        background-color: var(--surface-color);
        border-radius: var(--radius-md);
        overflow: hidden;
        box-shadow: var(--shadow-md);
        transition: var(--transition);
        height: 100%;
        display: flex;
        flex-direction: column;
    }

        .property-card:hover {
            box-shadow: var(--shadow-lg);
            transform: translateY(-4px);
        }

    /* Card media */
    .card-media {
        height: 220px;
        position: relative;
        overflow: hidden;
    }

        .card-media img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: var(--transition);
        }

    .property-card:hover .card-media img {
        transform: scale(1.05);
    }

    .media-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(45deg, #f1f5f9, #e2e8f0);
        color: var(--text-secondary);
        font-size: 3rem;
    }

    /* Property status */
    .property-status {
        position: absolute;
        top: 1rem;
        right: 1rem;
        padding: 0.4rem 0.8rem;
        border-radius: 50px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

        .property-status.available {
            background-color: rgba(16, 185, 129, 0.15);
            color: var(--success-color);
        }

        .property-status.reserved {
            background-color: rgba(239, 68, 68, 0.15);
            color: var(--error-color);
        }

        .property-status.pending {
            background-color: rgba(245, 158, 11, 0.15);
            color: var(--warning-color);
        }

    /* Card content */
    .card-content {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .property-title {
        font-size: 1.3rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: var(--text-primary);
    }

    .property-location {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-secondary);
        font-size: 0.9rem;
        margin-bottom: 1.5rem;
    }

    /* Property details */
    .property-details {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.75rem;
        margin-bottom: 1.5rem;
    }

    .detail-item {
        display: flex;
        flex-direction: column;
        padding: 0.75rem;
        background-color: var(--background-color);
        border-radius: var(--radius-sm);
        text-align: center;
    }

    .detail-value {
        font-weight: 600;
        color: var(--text-primary);
        font-size: 1rem;
        margin-bottom: 0.25rem;
    }

    .detail-label {
        font-size: 0.8rem;
        color: var(--text-secondary);
    }

    /* Card action */
    .card-action {
        margin-top: auto;
    }

    .reservation-button, .reserved-button {
        width: 100%;
        padding: 0.75rem !important;
        border-radius: var(--radius-sm) !important;
        font-weight: 500 !important;
        letter-spacing: 0.3px !important;
        transition: var(--transition) !important;
    }

    /* Loading state */
    .loading-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 1.5rem;
    }

    .property-card.loading {
        background-color: var(--surface-color);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
    }

    .card-image-skeleton {
        height: 220px;
        background-color: #e2e8f0;
        position: relative;
        overflow: hidden;
    }

        .card-image-skeleton::after {
            content: "";
            position: absolute;
            top: 0;
            right: 0;
            bottom: 0;
            left: 0;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
            animation: loading-animation 1.5s infinite;
        }

    .card-content-skeleton {
        padding: 1.5rem;
    }

    .skeleton-line {
        height: 1.2rem;
        width: 100%;
        background-color: #e2e8f0;
        border-radius: 4px;
        margin-bottom: 1rem;
        position: relative;
        overflow: hidden;
    }

        .skeleton-line::after {
            content: "";
            position: absolute;
            top: 0;
            right: 0;
            bottom: 0;
            left: 0;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
            animation: loading-animation 1.5s infinite;
        }

        .skeleton-line.short {
            width: 60%;
        }

    @@keyframes loading-animation {
        0% {
            transform: translateX(-100%);
        }

        100% {
            transform: translateX(100%);
        }
    }

    /* Empty state */
    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        background-color: var(--surface-color);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
    }

    .empty-icon {
        font-size: 4rem;
        color: var(--primary-light);
        margin-bottom: 1.5rem;
    }

    .empty-state h3 {
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 0.75rem;
    }

    .empty-state p {
        color: var(--text-secondary);
        max-width: 400px;
        margin: 0 auto;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 1rem;
        }

        .property-grid, .loading-grid {
            grid-template-columns: 1fr;
        }

        .property-details {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width: 480px) {
        .property-details {
            grid-template-columns: repeat(2, 1fr);
        }

        .detail-item:last-child {
            grid-column: span 2;
        }
    }
</style>

@code {
    private ObservableCollection<PropertyDto> _properties;
    private string? _currentUserId;
    private Dictionary<int, bool> _propertyReservationStatus = new Dictionary<int, bool>();
    private List<ReservationDto> _allReservations = new(); // Store all reservations

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                _currentUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ??
                                   user.FindFirst("sub")?.Value ??
                                   user.FindFirst("nameid")?.Value ??
                                   user.FindFirst("userId")?.Value ??
                                   user.FindFirst("Id")?.Value;
            }

            Logger.LogInformation("Starting to load properties...");
            _properties = await PropertyService.GetAll();
            Logger.LogInformation($"Loaded {_properties?.Count ?? 0} properties");

            Logger.LogInformation("Starting to load all reservations...");
            var reservationsCollection = await ReservationService.GetAll();
            _allReservations = reservationsCollection.ToList(); // Explicitly convert to List
            Logger.LogInformation($"Loaded {_allReservations?.Count ?? 0} reservations");

            // Check and update reservation status for all properties
            await UpdateReservationStatuses();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error in OnInitializedAsync");
            _properties = new ObservableCollection<PropertyDto>();
            _allReservations = new List<ReservationDto>();
        }
    }

    private async Task RefreshProperties()
    {
        try
        {
            _properties = await PropertyService.GetAll();
            // Important: Update the reservation statuses whenever properties are refreshed
            var reservationsCollection = await ReservationService.GetAll(); // Reload all reservations
            _allReservations = reservationsCollection.ToList(); // Explicitly convert to List
            await UpdateReservationStatuses();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error refreshing properties");
        }
    }

   private async Task UpdateReservationStatuses()
{
    try
    {
        _propertyReservationStatus.Clear();
        var today = DateTime.Today;

        foreach (var property in _properties)
        {
            // Check if there are any active or upcoming CONFIRMED reservations for this property
            bool hasActiveReservation = _allReservations.Any(r =>
                r.PropertyId == property.PropertyId &&
                r.Status?.Equals("Confirmed", StringComparison.OrdinalIgnoreCase) == true &&
                r.EndDate >= today); // Only consider current and future reservations

            _propertyReservationStatus[property.PropertyId] = hasActiveReservation;
        }

        Logger.LogInformation($"Updated reservation statuses for {_propertyReservationStatus.Count} properties");
    }
    catch (Exception ex)
    {
        Logger.LogError(ex, "Error updating reservation statuses");
    }
}

    private bool IsPropertyAvailable(PropertyDto property)
{
    // First check if the property itself is marked as unavailable
    if (property.Status?.Equals("Available", StringComparison.OrdinalIgnoreCase) != true)
    {
        return false;
    }

    // Then check our dictionary for the real-time reservation status
    if (_propertyReservationStatus.TryGetValue(property.PropertyId, out bool isReserved))
    {
        return !isReserved;
    }

    // If we don't have reservation info, default to the property's status
    return true;
}

    private string GetPropertyStatus(PropertyDto property)
    {
        var today = DateTime.Today;
        
        // Check for confirmed reservations
        bool hasConfirmedReservation = _allReservations.Any(r =>
            r.PropertyId == property.PropertyId &&
            r.Status?.Equals("Confirmed", StringComparison.OrdinalIgnoreCase) == true &&
            r.EndDate >= today);

        // Check for pending reservations
        bool hasPendingReservation = _allReservations.Any(r =>
            r.PropertyId == property.PropertyId &&
            r.Status?.Equals("Pending", StringComparison.OrdinalIgnoreCase) == true &&
            r.EndDate >= today);

        if (hasConfirmedReservation)
        {
            return "Reserved";
        }
        else if (hasPendingReservation)
        {
            return "Pending";
        }

        // If the property itself is marked as unavailable, use that status
        if (property.Status?.Equals("Available", StringComparison.OrdinalIgnoreCase) != true)
        {
            return property.Status ?? "Unavailable";
        }

        // Property is available
        return "Available";
    }


private void LogPropertyStatus(PropertyDto property)
{
    var dictionaryStatus = _propertyReservationStatus.TryGetValue(property.PropertyId, out bool isReserved) 
        ? (isReserved ? "Reserved" : "Available") 
        : "Unknown";
    
    Logger.LogInformation($"Property {property.PropertyId} - {property.Title}: " +
        $"Property.Status={property.Status}, " +
        $"Dictionary status={dictionaryStatus}, " +
        $"Final status={GetPropertyStatus(property)}");
}

    private async Task CreateReservation(PropertyDto property)
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            Snackbar.Add("Please login to make a reservation", Severity.Warning);
            return;
        }

        // Pokušaj dohvaćanja userId-a iz tvrdnji
        var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(userId))
        {
            userId = await tokenStorage.GetAccountId();
        }

        if (string.IsNullOrEmpty(userId))
        {
            Snackbar.Add("Unable to identify user. Please try logging in again.", Severity.Error);
            return;
        }

        if (property?.PropertyId == 0)
        {
            Snackbar.Add("Invalid property information", Severity.Error);
            return;
        }

        Console.WriteLine($"Creating reservation with UserId: {userId}, PropertyId: {property.PropertyId}");

        var parameters = new DialogParameters
            {
                ["PropertyId"] = property.PropertyId,
                ["AccountId"] = userId,
                ["PropertyTitle"] = property.Title,
                ["StartDate"] = DateTime.Today,
                ["EndDate"] = DateTime.Today.AddDays(7)
            };

        var options = new DialogOptions
            {
                CloseButton = true,
                MaxWidth = MaxWidth.Small,
                FullWidth = true
            };

        var dialog = await DialogService.ShowAsync<ReservationFormDialog>("Make Reservation", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await RefreshProperties();
        }
    }
}