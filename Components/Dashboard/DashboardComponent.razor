@using Components.Reservations
@using Contract
@using System.Collections.ObjectModel
@using Microsoft.Extensions.Logging
@using Services.ReservationService
@using System.Security.Claims
@inject IPropertyService PropertyService
@inject IReservationService ReservationService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<DashboardComponent> Logger
@inject TokenStorage tokenStorage

<div class="row g-4">
    @if (_properties == null)
    {
        <div class="col-12">
            <div class="text-center">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        </div>
    }
    else if (!_properties.Any())
    {
        <div class="col-12">
            <div class="alert alert-info">
                No properties found. Start by adding your first property!
            </div>
        </div>
    }
    else
    {
        @foreach (var property in _properties)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    @if (property.Images != null && property.Images.Any())
                    {
                        <img src="@property.Images.First().ImageUrl" class="card-img-top" alt="@property.Title" style="height: 200px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                            <i class="bi bi-house-door fs-1"></i>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@property.Title</h5>
                        <p class="card-text text-muted">@property.Address</p>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge bg-primary">@property.PropertyType</span>
                            <strong class="text-success">@property.Price.ToString("C")</strong>
                        </div>
                        <div class="row g-2 text-center mb-3">
                         
                            <div class="col-4">
                                <small class="text-muted d-block">Area</small>
                                <strong>@property.Area m²</strong>
                            </div>
                        </div>
                        <div class="d-grid gap-2">
                            <a href="/properties/@property.PropertyId" class="btn btn-outline-primary">View Details</a>
                            @if (property.Status == "Available")
                            {
                                <MudButton Color="Color.Primary" 
                                          Variant="Variant.Filled" 
                                          OnClick="@(() => CreateReservation(property))"
                                          Disabled="@(property.Status != "Available")">
                                  Make Reservation
                                </MudButton>
                            }
                            else
                            {
                                <MudButton Color="Color.Error" 
                                          Variant="Variant.Filled" 
                                          Disabled="true">
                                  @property.Status
                                </MudButton>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private ObservableCollection<PropertyDto> _properties;
    private string? _currentUserId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            
            Console.WriteLine($"Is authenticated: {user.Identity?.IsAuthenticated}");
            Console.WriteLine("All claims:");
            foreach (var claim in user.Claims)
            {
                Console.WriteLine($"Type: {claim.Type}, Value: {claim.Value}");
            }

            if (user.Identity?.IsAuthenticated == true)
            {
                _currentUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? 
                               user.FindFirst("sub")?.Value ??
                               user.FindFirst("nameid")?.Value ??
                               user.FindFirst("userId")?.Value ??
                               user.FindFirst("Id")?.Value;

                Console.WriteLine($"Current user ID: {_currentUserId}");
            }
            else
            {
                Console.WriteLine("User is not authenticated");
            }

            Logger.LogInformation("Starting to load properties...");
            _properties = await PropertyService.GetAll();
            Logger.LogInformation($"Loaded {_properties?.Count ?? 0} properties");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in OnInitializedAsync: {ex.Message}");
            _properties = new ObservableCollection<PropertyDto>();
        }
    }

    private async Task CreateReservation(PropertyDto property)
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        
        if (!user.Identity?.IsAuthenticated ?? true)
        {
            Snackbar.Add("Please login to make a reservation", Severity.Warning);
            return;
        }

        // Prvo pokušaj iz claims-a
        var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        
        // Ako nema u claims-u, uzmi iz storage-a
        if (string.IsNullOrEmpty(userId))
        {
            userId = await tokenStorage.GetAccountId();
        }

        if (string.IsNullOrEmpty(userId))
        {
            Snackbar.Add("Unable to identify user. Please try logging in again.", Severity.Error);
            return;
        }

        if (property?.PropertyId == 0 || string.IsNullOrEmpty(property?.Title))
        {
            Snackbar.Add("Invalid property information", Severity.Error);
            return;
        }

        Console.WriteLine($"Creating reservation with UserId: {userId}, PropertyId: {property.PropertyId}");

        var parameters = new DialogParameters
        {
            ["PropertyId"] = property.PropertyId,
            ["AccountId"] = userId,
            ["PropertyTitle"] = property.Title
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<ReservationFormDialog>("Make Reservation", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await RefreshProperties();
        }
    }

    private async Task RefreshProperties()
    {
        try
        {
            _properties = await PropertyService.GetAll();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error refreshing properties");
        }
    }
}
