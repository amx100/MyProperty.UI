@using Components.Dialog
@using Contract
@using MudBlazor
@inherits PropertyListViewModel

<MudTable Class="ml-4 mt-4 mr-4" Elevation="4" Items="@Properties" Dense Hover="true" Bordered="false" Filter="new Func<PropertyDto, bool>(FilterFunc)" Loading="@Loading">
    <ToolBarContent>
        <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Tertiary" Variant="Variant.Outlined" style="font-weight: bold;" OnClick="@(() => CreateOrUpdateProperty(new PropertyDto()))">
            Create New Property
        </MudButton>
        <MudSpacer />
        <MudTextField T="string" Label="Search" Variant="Variant.Outlined" @bind-Value="SearchPropertyName" Clearable="true" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" />
    </ToolBarContent>
    <ColGroup>
        <col />
        <col />
        <col />
        <col style="width:2px;" />
        <col style="width:2px;" />
    </ColGroup>
    <HeaderContent>
        <MudTh style="color:var(--mud-palette-primary); font-weight: bold;">Image</MudTh>
        <MudTh style="color:var(--mud-palette-primary); font-weight: bold;">Title</MudTh>
        <MudTh style="color:var(--mud-palette-primary); font-weight: bold;">Description</MudTh>
         <MudTh style="color:var(--mud-palette-primary); font-weight: bold;">Address</MudTh>
        <MudTh style="color:var(--mud-palette-primary); font-weight: bold;">Price</MudTh>
        <MudTh style="color:var(--mud-palette-primary); font-weight: bold;">Property Type</MudTh>
        <MudTh style="color:var(--mud-palette-primary); font-weight: bold;">Status</MudTh>
        <MudTh style="color:var(--mud-palette-primary); font-weight: bold;">Area</MudTh>
        <MudTh style="color:var(--mud-palette-primary); font-weight: bold;"></MudTh>
    </HeaderContent>
<RowTemplate Context="property">
    <MudTd>
        @if (property.Images != null && property.Images.Any())
        {
            <MudImage Src="@property.Images.First().ImageUrl" Alt="Property Image" 
                      Width="100" Height="75" ObjectFit="ObjectFit.Cover" 
                      Elevation="25" Class="rounded-lg"/>
        }
        else
        {
            <MudImage Src="images/no-image.png" Alt="No Image" 
                      Width="100" Height="75" ObjectFit="ObjectFit.Cover" 
                      Elevation="25" Class="rounded-lg"/>
        }
    </MudTd>
    <MudTd>@property.Title</MudTd>
    <MudTd>@property.Description</MudTd>
    <MudTd>@property.Address</MudTd>
    <MudTd>@property.Price</MudTd>
    <MudTd>@property.PropertyType</MudTd>
    <MudTd>@property.Status</MudTd>
    <MudTd>@property.Area</MudTd>
    <MudTd>
        <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="() => CreateOrUpdateProperty(property)" />
        <MudIconButton Icon="@Icons.Material.Filled.Image" 
                      OnClick="() => ManageImages(property)"
                      Color="Color.Primary"
                      Title="Manage Images" />
    </MudTd>
    <MudTd>
        <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="() => DeleteProperty(property)" />
    </MudTd>
</RowTemplate>

    <NoRecordsContent>
        <MudText>No properties found</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>Loading...</MudText>
    </LoadingContent>
    <PagerContent>
        <MudTablePager RowsPerPageString="Items per page" InfoFormat="@InfoFormat" />
    </PagerContent>
</MudTable>

@code {
    protected async Task DeleteProperty(PropertyDto property)
    {
        var parameters = new DialogParameters();
        parameters.Add("ContentText", "Are you sure you want to delete this property?");
        parameters.Add("ButtonText", "Delete");
        parameters.Add("Color", Color.Error);

        var options = new DialogOptions() 
        { 
            CloseButton = true, 
            MaxWidth = MaxWidth.ExtraSmall 
        };
        
        var dialog = await DialogService!.ShowAsync<ConfirmComponent>("Delete Property", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            Loading = true;
            StateHasChanged();
            
            var response = await PropertyService!.Delete(property.PropertyId);
            HandleResponse(response, property);
            
            Loading = false;
            StateHasChanged();
        }
    }
}


