@using Components.Dialog
@using Contract
@using MudBlazor
@inherits PropertyListViewModel

<MudPaper Elevation="0" Class="pa-4 rounded-lg" Style="background-color: #CDD2D8; margin: 16px;">
    <MudCard Elevation="2" Class="rounded-xl overflow-hidden">
        <MudCardHeader Style="background-color: #1C2338; padding: 16px;">
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Style="color: white; font-weight: 500;">
                    Property Management
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton StartIcon="@Icons.Material.Filled.Add"
                           Color="Color.Primary"
                           Variant="Variant.Filled"
                           Style="background-color: #6C85B0; color: white; font-weight: 500;"
                           OnClick="@(() => CreateOrUpdateProperty(new PropertyDto()))">
                    New Property
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent Class="pa-0">
            <MudPaper Elevation="0" Class="d-flex align-center pa-4" 
                      Style="background-color: white; border-bottom: 1px solid #CDD2D8;">
                <MudText Typo="Typo.subtitle1" Style="color: #6A7382; font-weight: 500;">
                    All Properties
                </MudText>
                <MudSpacer />
                <MudTextField T="string"
                              Placeholder="Search properties..."
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Search"
                              AdornmentColor="Color.Primary"
                              Style="width: 300px;"
                              Class="ml-auto"
                              @bind-Value="SearchPropertyName"
                              Clearable="true"
                              Immediate="true" />
            </MudPaper>

            <MudTable Items="@Properties"
                      Dense="false"
                      Hover="true"
                      Bordered="false"
                      Filter="new Func<PropertyDto, bool>(FilterFunc)"
                      Loading="@Loading"
                      Breakpoint="Breakpoint.Sm"
                      LoadingProgressColor="Color.Primary"
                      Style="color: #6A7382;">
                <ColGroup>
                    <col />
                    <col />
                    <col />
                    <col />
                    <col />
                    <col />
                    <col />
                    <col />
                    <col style="width:120px;" />
                </ColGroup>
                <HeaderContent>
                    <MudTh Style="color: #1C2338; font-weight: 500;">Image</MudTh>
                    <MudTh Style="color: #1C2338; font-weight: 500;">Title</MudTh>
                    <MudTh Style="color: #1C2338; font-weight: 500;">Description</MudTh>
                    <MudTh Style="color: #1C2338; font-weight: 500;">Address</MudTh>
                    <MudTh Style="color: #1C2338; font-weight: 500;">Price</MudTh>
                    <MudTh Style="color: #1C2338; font-weight: 500;">Property Type</MudTh>
                    <MudTh Style="color: #1C2338; font-weight: 500;">Area</MudTh>
                    <MudTh Style="color: #1C2338; font-weight: 500;">Actions</MudTh>
                </HeaderContent>
                <RowTemplate Context="property">
                    <MudTd>
                        @if (property.Images != null && property.Images.Any())
                        {
                            <MudAvatar Size="Size.Large" Style="height: 64px; width: 100px; border-radius: 8px;">
                                <MudImage Src="@property.Images.First().ImageUrl"
                                          Alt="Property Image"
                                          ObjectFit="ObjectFit.Cover" />
                            </MudAvatar>
                        }
                        else
                        {
                            <MudAvatar Size="Size.Large" Style="height: 64px; width: 100px; border-radius: 8px; background-color: #CDD2D8;">
                                <MudIcon Icon="@Icons.Material.Outlined.Home" Size="Size.Large" Color="Color.Default" />
                            </MudAvatar>
                        }
                    </MudTd>
                    <MudTd DataLabel="Title">
                        <MudText Typo="Typo.body1" Style="font-weight: 500; color: #1C2338;">
                            @property.Title
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Description">
                        <MudText Typo="Typo.body2" Style="color: #8C95A1;">
                            @(property.Description?.Length > 50 
                                ? property.Description.Substring(0, 50) + "..." 
                                : property.Description)
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Address">
                        @property.Address
                    </MudTd>
                    <MudTd DataLabel="Price">
                        <MudText Style="font-weight: 500; color: #6C85B0;">
                            @property.Price
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Property Type">
                        <MudChip T="string" Size="Size.Small"
                                 Color="Color.Primary"
                                 Style="background-color: #6C85B0; color: white;">
                            @property.PropertyType
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Area">
                        @property.Area
                    </MudTd>
                    <MudTd>
                        <div class="d-flex">
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           Style="color: #6C85B0;"
                                           OnClick="() => CreateOrUpdateProperty(property)"
                                           Title="Edit Property" />
                            <MudIconButton Icon="@Icons.Material.Outlined.Photo"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           Style="color: #6C85B0;"
                                           OnClick="() => ManageImages(property)"
                                           Title="Manage Images" />
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="() => DeleteProperty(property)"
                                           Title="Delete Property" />
                        </div>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="d-flex flex-column align-center justify-center pa-4">
                        <MudIcon Icon="@Icons.Material.Outlined.Search"
                                 Size="Size.Large"
                                 Style="color: #8C95A1; margin-bottom: 16px;" />
                        <MudText Typo="Typo.subtitle1" Style="color: #6A7382;">
                            No properties found
                        </MudText>
                        <MudText Typo="Typo.body2" Style="color: #8C95A1;">
                            Try adjusting your search or create a new property.
                        </MudText>
                    </div>
                </NoRecordsContent>
                <LoadingContent>
                    <div class="d-flex justify-center align-center pa-4">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                        <MudText Class="ml-3">Loading properties...</MudText>
                    </div>
                </LoadingContent>
                <PagerContent>
                    <MudTablePager RowsPerPageString="Properties per page"
                                   InfoFormat="@InfoFormat"
                                   Style="color: #6A7382;" />
                </PagerContent>
            </MudTable>
        </MudCardContent>
    </MudCard>
</MudPaper>

@code {
    protected async Task DeleteProperty(PropertyDto property)
    {
        var parameters = new DialogParameters();
        parameters.Add("ContentText", "Are you sure you want to delete this property?");
        parameters.Add("ButtonText", "Delete");
        parameters.Add("Color", Color.Error);

        var options = new DialogOptions()
        {
            CloseButton = true,
            MaxWidth = MaxWidth.ExtraSmall,
            CloseOnEscapeKey = true,
            FullWidth = true,
            NoHeader = false,
            Position = DialogPosition.Center
        };

        var dialog = await DialogService!.ShowAsync<ConfirmComponent>("Delete Property", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            Loading = true;
            StateHasChanged();

            var response = await PropertyService!.Delete(property.PropertyId);
            HandleResponse(response, property);

            Loading = false;
            StateHasChanged();
        }
    }
}