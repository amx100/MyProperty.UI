@inherits PropertyFormViewModel

@if (PropertyCreate != null && PropertyCreate.PropertyId == 0)  
    
{
    <MudDialog Style="width:inherit">
        <DialogContent>
            <MudCard>
                <MudCardContent>
                    <MudItem xs="12">
                        <MudTextField Label="Property Title" Variant="Variant.Outlined" Immediate=true Required RequiredError=@ValidationMessage
                                      @bind-Value="PropertyCreate.Title" For="@(() => PropertyCreate.Title)" />

                        <MudTextField Label="Description" Variant="Variant.Outlined" Immediate=true Required RequiredError=@ValidationMessage
                                      @bind-Value="PropertyCreate.Description" For="@(() => PropertyCreate.Description)" />

                        <MudTextField Label="Address" Variant="Variant.Outlined" Immediate=true Required RequiredError=@ValidationMessage
                                      @bind-Value="PropertyCreate.Address" For="@(() => PropertyCreate.Address)" />

                        <MudNumericField Label="Price" Variant="Variant.Outlined" Immediate=true
                                         @bind-Value="PropertyCreate.Price" For="@(() => PropertyCreate.Price)" />

                        <MudSelect T="string" 
                                 Label="Property Type" 
                                 Variant="Variant.Outlined"
                                 @bind-Value="PropertyCreate.PropertyType">
                            @foreach (var type in PropertyTypes)
                            {
                                <MudSelectItem Value="@type">@type</MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect T="string" 
                                 Label="Status" 
                                 Variant="Variant.Outlined"
                                 @bind-Value="PropertyCreate.Status">
                            @foreach (var status in StatusOptions)
                            {
                                <MudSelectItem Value="@status">@status</MudSelectItem>
                            }
                        </MudSelect>

                        <MudNumericField Label="Size (sqm)/Area" Variant="Variant.Outlined" Immediate=true
                                         @bind-Value="PropertyCreate.Area" For="@(() => PropertyCreate.Area)" />
                    </MudItem>
                </MudCardContent>
            </MudCard>
        </DialogContent>
        <DialogActions>
            <MudButton Color="Color.Tertiary" Variant="Variant.Filled" OnClick="() => Cancel()">Cancel</MudButton>
            <MudButton ButtonType="ButtonType.Submit" Disabled="@Disabled" Variant="Variant.Filled" Color="Color.Tertiary" OnClick="() => CreateOrUpdate()">Save</MudButton>
        </DialogActions>
    </MudDialog>
}
else
{
    <MudDialog Style="width:inherit">
        <DialogContent>
            <MudCard>
                <MudCardContent>
                    <MudItem xs="12">
                        <MudTextField Label="Property Title" Variant="Variant.Outlined" Immediate=true Required RequiredError=@ValidationMessage
                                      @bind-Value="PropertyUpdate.Title" For="@(() => PropertyUpdate.Title)" />

                        <MudTextField Label="Description" Variant="Variant.Outlined" Immediate=true Required RequiredError=@ValidationMessage
                                      @bind-Value="PropertyUpdate.Description" For="@(() => PropertyUpdate.Description)" />

                        <MudTextField Label="Location" Variant="Variant.Outlined" Immediate=true Required RequiredError=@ValidationMessage
                                      @bind-Value="PropertyUpdate.Address" For="@(() => PropertyUpdate.Address)" />

                        <MudNumericField Label="Price" Variant="Variant.Outlined" Immediate=true
                                         @bind-Value="PropertyUpdate.Price" For="@(() => PropertyUpdate.Price)" />

                        <MudTextField Label="Property Type" Variant="Variant.Outlined" Immediate=true
                                         @bind-Value="PropertyUpdate.PropertyType" For="@(() => PropertyUpdate.PropertyType)" />

                        <MudTextField Label="Status" Variant="Variant.Outlined" Immediate=true
                                         @bind-Value="PropertyUpdate.Status" For="@(() => PropertyUpdate.Status)" />

                        <MudNumericField Label="Size (sqm)/Area" Variant="Variant.Outlined" Immediate=true
                                         @bind-Value="PropertyUpdate.Area" For="@(() => PropertyUpdate.Area)" />
                    </MudItem>
                </MudCardContent>
            </MudCard>
        </DialogContent>
        <DialogActions>
            <MudButton Color="Color.Tertiary" Variant="Variant.Filled" OnClick="() => Cancel()">Cancel</MudButton>
            <MudButton ButtonType="ButtonType.Submit" Disabled="@Disabled" Variant="Variant.Filled" Color="Color.Tertiary" OnClick="() => CreateOrUpdate()">Save</MudButton>
        </DialogActions>
    </MudDialog>
}
