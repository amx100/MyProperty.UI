@using Contract
@inherits PropertyImageListViewModel

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.PhotoLibrary" Class="mr-2" />
            Property Gallery
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudContainer Style="max-height: 70vh; overflow-y: auto">
            @if (PropertyImages.Any())
            {
                <MudGrid Spacing="3">
                    @foreach (var image in PropertyImages)
                    {
                        <MudItem xs="12" sm="6" md="4" lg="4">
                            <MudCard Elevation="2" Class="image-card h-100">
                                <MudCardMedia Image="@image.ImageUrl"
                                             Height="180"
                                             Class="image-hover-effect" />
                                <MudCardActions Class="py-2 px-3 d-flex justify-space-between">
                                    <MudTooltip Text="Edit Image">
                                        <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                                      Color="Color.Primary"
                                                      Size="Size.Small"
                                                      OnClick="@(() => CreateOrUpdatePropertyImage(image))" />
                                    </MudTooltip>
                                    <MudTooltip Text="Delete Image">
                                        <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                                      Color="Color.Error"
                                                      Size="Size.Small"
                                                      OnClick="@(() => DeletePropertyImage(image))" />
                                    </MudTooltip>
                                </MudCardActions>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            }
            else
            {
                <MudPaper Elevation="0" Class="pa-6 mt-4 d-flex flex-column align-center justify-center" Style="background-color: var(--mud-palette-background-grey); min-height: 200px;">
                    <MudIcon Icon="@Icons.Material.Outlined.ImageNotSupported" Size="Size.Large" Class="mb-3" Color="Color.Default" />
                    <MudText Typo="Typo.body1" Color="Color.Default" Style="opacity: 0.6;" Class="mb-4 text-center">No images have been added to this property yet.</MudText>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.AddPhotoAlternate"
                               OnClick="@(() => CreateOrUpdatePropertyImage(new PropertyImageDto { PropertyId = PropertyId }))">
                        Add First Image
                    </MudButton>
                </MudPaper>
            }
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudSpacer />
        @if (PropertyImages.Any())
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.AddPhotoAlternate"
                       OnClick="@(() => CreateOrUpdatePropertyImage(new PropertyImageDto { PropertyId = PropertyId }))">
                Add Image
            </MudButton>
        }
        <MudButton Variant="Variant.Text"
                   Color="Color.Default"
                   OnClick="Cancel">
            Close
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .image-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .image-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--mud-elevation-5);
    }

    .image-hover-effect {
        transition: opacity 0.3s;
    }

    .image-card:hover .image-hover-effect {
        opacity: 0.9;
    }
</style>

@code {
    [CascadingParameter]
    MudDialogInstance MudDialogInstance { get; set; }

    private void Cancel()
    {
        MudDialogInstance?.Close();
    }
}
