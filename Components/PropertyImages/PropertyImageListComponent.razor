@using Contract
@inherits PropertyImageListViewModel

<MudDialog Class="gallery-dialog" MaxWidth="MaxWidth.ExtraLarge" FullWidth="true">
    <TitleContent>
        <div class="dialog-title">
            <MudIcon Icon="@Icons.Material.Rounded.PhotoLibrary" Size="Size.Medium" />
            <MudText Typo="Typo.h5" Class="title-text">Property Gallery</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="gallery-container">
            @if (PropertyImages.Any())
            {
                <div class="gallery-grid">
                    @foreach (var image in PropertyImages)
                    {
                        <div class="gallery-item">
                            <div class="image-card">
                                <div class="image-wrapper">
                                    <img src="@image.ImageUrl" alt="Property Image" />
                                    <div class="image-overlay">
                                        <div class="action-buttons">
                                            <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                                                           Class="action-button edit"
                                                           OnClick="@(() => CreateOrUpdatePropertyImage(image))" />
                                            <MudIconButton Icon="@Icons.Material.Rounded.Delete"
                                                           Class="action-button delete"
                                                           OnClick="@(() => DeletePropertyImage(image))" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-state-content">
                        <MudIcon Icon="@Icons.Material.Rounded.ImageNotSupported" Size="Size.Large" Class="empty-icon" />
                        <MudText Typo="Typo.body1" Class="empty-text">No images have been added to this property yet.</MudText>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Rounded.AddPhotoAlternate"
                                   Class="add-first-button"
                                   OnClick="@(() => CreateOrUpdatePropertyImage(new PropertyImageDto { PropertyId = PropertyId }))">
                            Add First Image
                        </MudButton>
                    </div>
                </div>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudSpacer />
        @if (PropertyImages.Any())
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Rounded.AddPhotoAlternate"
                       Class="add-image-button"
                       OnClick="@(() => CreateOrUpdatePropertyImage(new PropertyImageDto { PropertyId = PropertyId }))">
                Add Image
            </MudButton>
        }
        <MudButton Variant="Variant.Text"
                   Color="Color.Default"
                   Class="close-button"
                   OnClick="Cancel">
            Close
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    :root {
        --border-radius: 12px;
        --card-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        --overlay-bg: rgba(0, 0, 0, 0.5);
        --hover-transform: translateY(-6px);
        --transition-speed: 0.3s;
    }

    .gallery-dialog {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .dialog-title {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px 24px;
        border-bottom: 1px solid var(--mud-palette-divider);
    }

    .title-text {
        font-weight: 500;
    }

    .gallery-container {
        max-height: 70vh;
        overflow-y: auto;
        padding: 16px;
        background-color: var(--mud-palette-background);
    }

    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 20px;
        padding: 4px;
    }

    .gallery-item {
        position: relative;
        aspect-ratio: 4 / 3;
    }

    .image-card {
        height: 100%;
        border-radius: var(--border-radius);
        overflow: hidden;
        box-shadow: var(--card-shadow);
        transition: transform var(--transition-speed), box-shadow var(--transition-speed);
    }

    .image-card:hover {
        transform: var(--hover-transform);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
    }

    .image-wrapper {
        position: relative;
        height: 100%;
        overflow: hidden;
    }

    .image-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform var(--transition-speed);
    }

    .image-card:hover .image-wrapper img {
        transform: scale(1.05);
    }

    .image-overlay {
        position: absolute;
        inset: 0;
        background: var(--overlay-bg);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity var(--transition-speed);
    }

    .image-card:hover .image-overlay {
        opacity: 1;
    }

    .action-buttons {
        display: flex;
        gap: 16px;
    }

    .action-button {
        color: white;
        background-color: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        padding: 8px;
        transform: scale(0.8);
        transition: transform var(--transition-speed), background-color var(--transition-speed);
    }

    .action-button:hover {
        transform: scale(1);
    }

    .action-button.edit:hover {
        background-color: var(--mud-palette-primary);
    }

    .action-button.delete:hover {
        background-color: var(--mud-palette-error);
    }

    .empty-state {
        min-height: 300px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: var(--mud-palette-background-grey);
        border-radius: var(--border-radius);
        margin: 16px;
    }

    .empty-state-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 40px 20px;
        text-align: center;
    }

    .empty-icon {
        color: var(--mud-palette-text-secondary);
        opacity: 0.5;
        margin-bottom: 16px;
        font-size: 48px;
    }

    .empty-text {
        color: var(--mud-palette-text-secondary);
        opacity: 0.7;
        margin-bottom: 24px;
    }

    .add-first-button, .add-image-button, .close-button {
        border-radius: var(--border-radius);
        padding: 8px 20px;
    }
</style>

@code {
    [CascadingParameter]
    MudDialogInstance MudDialogInstance { get; set; }

    private void Cancel() => MudDialogInstance?.Close();
}
