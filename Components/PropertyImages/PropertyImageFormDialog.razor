@using Contract
@using static MudBlazor.CategoryTypes
@inherits PropertyImageFormViewModel

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Class="d-flex align-center">
            <MudIcon Icon="@(PropertyImageCreate != null ? Icons.Material.Filled.AddPhotoAlternate : Icons.Material.Filled.Edit)" Class="mr-2" />
            @(PropertyImageCreate != null ? "Add Property Image" : "Edit Property Image")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm Model="@(PropertyImageCreate ?? (object)PropertyImageUpdate)" @ref="form">
            <MudGrid>
                <MudItem xs="12">
                    <MudCard Elevation="0" Class="rounded-lg pb-4">
                        <MudCardContent>
                            <MudGrid>
                                <MudItem xs="12">
                                    <MudTextField Label="Image URL"
                                                @bind-Value="ImageUrl"
                                                For="@(() => ImageUrl)"
                                                Required="true"
                                                RequiredError="@ValidationMessage"
                                                Variant="Variant.Outlined"
                                                Adornment="Adornment.Start"
                                                AdornmentIcon="@Icons.Material.Filled.Link"
                                                Class="mb-4" />
                                </MudItem>
                                <MudItem xs="12">
                                    <InputFile id="fileInput"
                                             OnChange="OnFileSelected"
                                             Accept=".jpg,.jpeg,.png,.gif"
                                             hidden />
                                    <MudPaper Elevation="0" Class="pa-4 upload-container" Style="border: 2px dashed var(--mud-palette-primary-lighten); border-radius: 8px;">
                                        <MudButton HtmlTag="label"
                                                 Variant="Variant.Text"
                                                 Color="Color.Primary"
                                                 for="fileInput"
                                                 Class="w-100 py-8">
                                            <div class="d-flex flex-column align-center">
                                                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" Class="mb-4" />
                                                <MudText Typo="Typo.body1" Class="mb-1">Drop files here or click to upload</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Surface" Style="opacity: 0.7">Supported formats: JPG, PNG, GIF</MudText>
                                            </div>
                                        </MudButton>
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>

                            @if (!string.IsNullOrEmpty(PropertyImageCreate?.ImageUrl ?? PropertyImageUpdate?.ImageUrl))
                            {
                                <MudPaper Elevation="0" Class="mt-6 rounded-lg overflow-hidden">
                                    <MudText Typo="Typo.subtitle2" Class="mb-2">Image Preview</MudText>
                                    <div class="preview-container">
                                        <MudImage Src="@(PropertyImageCreate?.ImageUrl ?? PropertyImageUpdate?.ImageUrl)"
                                                  Alt="Property Image"
                                                  ObjectFit="ObjectFit.Cover"
                                                  Elevation="0"
                                                  Class="rounded-lg"
                                                  Style="width: 100%; max-height: 300px;" />
                                    </div>
                                </MudPaper>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" 
                   Color="Color.Default" 
                   OnClick="@(() => MudDialogInstance?.Cancel())"
                   StartIcon="@Icons.Material.Filled.Close">
            Cancel
        </MudButton>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   OnClick="CreateOrUpdate" 
                   Loading="@_processing" 
                   Disabled="@Disabled"
                   Class="px-6"
                   StartIcon="@(PropertyImageCreate != null ? Icons.Material.Filled.Add : Icons.Material.Filled.Save)">
            @(PropertyImageCreate != null ? "Add Image" : "Save Changes")
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .upload-container {
        transition: all 0.2s;
    }

    .upload-container:hover {
        border-color: var(--mud-palette-primary);
        background-color: var(--mud-palette-primary-lighten);
        background-opacity: 0.05;
    }

    .preview-container {
        position: relative;
        background-color: var(--mud-palette-background-grey);
        border-radius: 8px;
        padding: 16px;
        display: flex;
        justify-content: center;
    }
</style>

@code {
    private MudForm form;
    private bool _processing;

    [CascadingParameter]
    MudDialogInstance MudDialogInstance { get; set; }

    private string ImageUrl
    {
        get => PropertyImageCreate?.ImageUrl ?? PropertyImageUpdate?.ImageUrl ?? string.Empty;
        set
        {
            if (PropertyImageCreate != null)
                PropertyImageCreate.ImageUrl = value;
            else if (PropertyImageUpdate != null)
                PropertyImageUpdate.ImageUrl = value;
        }
    }
}