@using Contract
@using static MudBlazor.CategoryTypes
@inherits PropertyImageFormViewModel

<MudDialog Class="form-dialog">
    <TitleContent>
        <div class="dialog-title">
            <MudIcon Icon="@(PropertyImageCreate != null ? Icons.Material.Rounded.AddPhotoAlternate : Icons.Material.Rounded.Edit)" 
                    Size="Size.Medium" />
            <MudText Typo="Typo.h6">@(PropertyImageCreate != null ? "Add Property Image" : "Edit Property Image")</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudForm Model="@(PropertyImageCreate ?? (object)PropertyImageUpdate)" @ref="form">
            <div class="form-container">
                <div class="input-section">
                    <MudTextField Label="Image URL"
                                @bind-Value="ImageUrl"
                                For="@(() => ImageUrl)"
                                Required="true"
                                RequiredError="@ValidationMessage"
                                Variant="Variant.Outlined"
                                Class="url-input"
                                FullWidth="true"
                                Adornment="Adornment.Start"
                                AdornmentIcon="@Icons.Material.Rounded.Link" />
                </div>
                
                <div class="upload-section">
                    <InputFile id="fileInput"
                             OnChange="OnFileSelected"
                             Accept=".jpg,.jpeg,.png,.gif"
                             hidden />
                    <div class="dropzone">
                        <label for="fileInput" class="dropzone-label">
                            <div class="dropzone-content">
                                <MudIcon Icon="@Icons.Material.Rounded.CloudUpload" Size="Size.Large" Class="upload-icon" />
                                <div class="upload-text-container">
                                    <MudText Typo="Typo.body1" Class="upload-text">Drop files here or click to upload</MudText>
                                    <MudText Typo="Typo.caption" Class="upload-subtext">Supported formats: JPG, PNG, GIF</MudText>
                                </div>
                            </div>
                        </label>
                    </div>
                </div>
                
                @if (!string.IsNullOrEmpty(PropertyImageCreate?.ImageUrl ?? PropertyImageUpdate?.ImageUrl))
                {
                    <div class="preview-section">
                        <MudText Typo="Typo.subtitle2" Class="preview-title">Image Preview</MudText>
                        <div class="preview-container">
                            <img src="@(PropertyImageCreate?.ImageUrl ?? PropertyImageUpdate?.ImageUrl)"
                                alt="Property Image Preview"
                                class="preview-image" />
                        </div>
                    </div>
                }
            </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <div class="action-buttons">
            <MudButton Variant="Variant.Text" 
                    Color="Color.Default" 
                    OnClick="@(() => MudDialogInstance?.Cancel())"
                    StartIcon="@Icons.Material.Rounded.Close"
                    Class="cancel-button">
                Cancel
            </MudButton>
            <MudButton Variant="Variant.Filled" 
                    Color="Color.Primary" 
                    OnClick="CreateOrUpdate" 
                    Loading="@_processing" 
                    Disabled="@Disabled"
                    StartIcon="@(PropertyImageCreate != null ? Icons.Material.Rounded.Add : Icons.Material.Rounded.Save)"
                    Class="submit-button">
                @(PropertyImageCreate != null ? "Add Image" : "Save Changes")
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>

<style>
    .form-dialog {
        --form-border-radius: 12px;
        --input-border-radius: 8px;
        --transition-speed: 0.3s;
    }

    .dialog-title {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px 24px;
    }

    .form-container {
        display: flex;
        flex-direction: column;
        gap: 24px;
        padding: 8px 4px;
    }

    .url-input {
        border-radius: var(--input-border-radius);
    }

    .dropzone {
        border: 2px dashed var(--mud-palette-primary-lighten);
        border-radius: var(--input-border-radius);
        background-color: rgba(var(--mud-palette-primary-rgb), 0.03);
        transition: all var(--transition-speed);
        overflow: hidden;
    }

    .dropzone:hover {
        border-color: var(--mud-palette-primary);
        background-color: rgba(var(--mud-palette-primary-rgb), 0.06);
    }

    .dropzone-label {
        display: block;
        width: 100%;
        cursor: pointer;
    }

    .dropzone-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 36px 24px;
    }

    .upload-icon {
        color: var(--mud-palette-primary);
        margin-bottom: 16px;
        font-size: 42px;
        opacity: 0.8;
    }

    .upload-text-container {
        text-align: center;
    }

    .upload-text {
        color: var(--mud-palette-text-primary);
        margin-bottom: 4px;
        font-weight: 500;
    }

    .upload-subtext {
        color: var(--mud-palette-text-secondary);
        opacity: 0.7;
    }

    .preview-section {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-top: 8px;
    }

    .preview-title {
        color: var(--mud-palette-text-primary);
        font-weight: 500;
    }

    .preview-container {
        background-color: rgba(var(--mud-palette-surface-rgb), 0.04);
        border-radius: var(--form-border-radius);
        padding: 16px;
        display: flex;
        justify-content: center;
        box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.05);
    }

    .preview-image {
        max-width: 100%;
        max-height: 300px;
        object-fit: contain;
        border-radius: calc(var(--form-border-radius) - 4px);
    }

    .action-buttons {
        display: flex;
        gap: 12px;
        padding: 8px 0;
    }

    .cancel-button, .submit-button {
        border-radius: var(--input-border-radius);
        padding: 8px 16px;
        min-width: 120px;
    }

    .submit-button {
        padding: 8px 24px;
        font-weight: 500;
    }
</style>

@code {
    private MudForm form;
    private bool _processing;

    [CascadingParameter]
    MudDialogInstance MudDialogInstance { get; set; }

    private string ImageUrl
    {
        get => PropertyImageCreate?.ImageUrl ?? PropertyImageUpdate?.ImageUrl ?? string.Empty;
        set
        {
            if (PropertyImageCreate != null)
                PropertyImageCreate.ImageUrl = value;
            else if (PropertyImageUpdate != null)
                PropertyImageUpdate.ImageUrl = value;
        }
    }
}