@using Contract
@using Services.ReservationService
@inject IReservationService ReservationService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudContainer Style="max-width: 500px">
            @if (string.IsNullOrEmpty(PropertyTitle) || PropertyId == 0 || string.IsNullOrEmpty(AccountId))
            {
                <MudAlert Severity="Severity.Error">Invalid reservation parameters</MudAlert>
            }
            else
            {
                <MudText Typo="Typo.h6" Class="mb-4">Reserve @PropertyTitle</MudText>
                
                <MudDateRangePicker @bind-DateRange="_dateRange" 
                                   Label="Reservation Period"
                                   DisablePassedDates="true"
                                   Required="true"
                                   Class="mb-4"/>

                @if (_errorMessage != null)
                {
                    <MudAlert Severity="Severity.Error" Class="my-2">@_errorMessage</MudAlert>
                }
            }
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" 
                  OnClick="Submit" 
                  Disabled="@(string.IsNullOrEmpty(PropertyTitle) || PropertyId == 0 || string.IsNullOrEmpty(AccountId) || _dateRange.Start == null || _dateRange.End == null)">
            Submit Reservation
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    
    [Parameter] public int PropertyId { get; set; }
    [Parameter] public string AccountId { get; set; }
    [Parameter] public string PropertyTitle { get; set; }
    [Parameter] public DateTime? StartDate { get; set; }
    [Parameter] public DateTime? EndDate { get; set; }

    private DateRange _dateRange = new DateRange();
    private string _errorMessage;

    protected override void OnInitialized()
    {
        if (string.IsNullOrEmpty(AccountId) || PropertyId == 0 || string.IsNullOrEmpty(PropertyTitle))
        {
            _errorMessage = "Invalid reservation parameters. Please try again.";
            Console.WriteLine($"Invalid parameters - AccountId: {AccountId}, PropertyId: {PropertyId}, Title: {PropertyTitle}");
        }
        
        // Initialize date range with passed parameters or default values
        _dateRange = new DateRange(
            StartDate ?? DateTime.Today,
            EndDate ?? DateTime.Today.AddDays(7)
        );
    }

    private async Task Submit()
    {
        if (_dateRange.Start == null || _dateRange.End == null)
        {
            _errorMessage = "Please select reservation dates";
            return;
        }

        if (string.IsNullOrEmpty(AccountId) || PropertyId == 0)
        {
            _errorMessage = "Invalid reservation parameters";
            return;
        }

        var reservation = new ReservationCreateDto
        {
            PropertyId = PropertyId,
            AccountId = AccountId,
            StartDate = _dateRange.Start.Value.Date,
            EndDate = _dateRange.End.Value.Date
        };

        try
        {
            Console.WriteLine($"Creating reservation: Start={reservation.StartDate:yyyy-MM-dd}, End={reservation.EndDate:yyyy-MM-dd}");
            var response = await ReservationService.Create(reservation);
            
            if (response.IsSuccess)
            {
                Snackbar.Add("Reservation request submitted successfully!", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                _errorMessage = response.Message ?? "Failed to create reservation";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "An error occurred while creating the reservation";
            Console.WriteLine($"Error creating reservation: {ex.Message}");
        }
    }

    private void Cancel() => MudDialog.Cancel();
} 